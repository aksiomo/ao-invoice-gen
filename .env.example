# OpenAI 兼容接口（适用于 OpenAI / DeepSeek / 通义千问 / Kimi 等兼容服务）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-请填入你的密钥
LLM_MODEL=gpt-4o-mini

# 可选：为两个 Agent 分别指定模型（不填则都用 LLM_MODEL）
# EXTRACTOR_MODEL=gpt-4o-mini
# CLASSIFIER_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0
LLM_TIMEOUT=120

# 检索与分类
TOP_K=20
CLASSIFY_BATCH_SIZE=50
EXTRACT_CHUNK_ROWS=200
FIXED_TAX_RATE=0.01
AMOUNT_TOLERANCE=0.02
MAX_UPLOAD_MB=20
